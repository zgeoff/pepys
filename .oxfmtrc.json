{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "bun.lock",
    "packages/*/src/generated/**",
    "packages/*/src/test-utils/*/generated/**",
    "packages/testing/src/ledger/generated/**",
    "e2e/*/src/generated/**",
    "docs/design/**/sketches/**"
  ],
  "proseWrap": "always",
  "semi": true,
  "trailingComma": "all",
  "singleQuote": true,
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "bracketSpacing": true,
  "arrowParens": "always",
  "sortImports": {
    "groups": [
      "side_effect",
      "test-libs",
      "builtin",
      "external",
      "unknown",
      ["parent", "sibling", "index"]
    ],
    "newlinesBetween": false,
    "sortSideEffects": false,
    "customGroups": [
      {
        "groupName": "test-libs",
        "elementNamePattern": ["bun:test"]
      }
    ]
  }
}
