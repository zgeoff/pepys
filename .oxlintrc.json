{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@zgeoff/oxlint-config/oxlintrc.json"],
  "env": {
    "node": true,
    "es2024": true
  },
  "rules": {
    // pepys is ES modules throughout, so a module loads through an import
    "typescript/no-require-imports": "error"
  },
  "overrides": [
    {
      // a subpath of the kit's exports map is a barrel, as src/index.ts is
      "files": ["packages/kit/src/generators.ts", "packages/kit/src/send.ts"],
      "rules": {
        "zgeoff/file-named-for-export": "off"
      }
    },
    {
      // an entry file exports the fixed names that scriptc and the host call: init, update, applyFact
      "files": [
        "packages/source-*/src/consumers/*.ts",
        "packages/*/src/test-utils/*/consumers/*.ts",
        "packages/testing/src/ledger/consumers/*.ts",
        "e2e/*/src/consumers/*.ts"
      ],
      "rules": {
        "zgeoff/file-named-for-export": "off"
      }
    },
    {
      // the fact envelope names its version field `v`, and the log doc fixes that name
      "files": ["packages/*/src/**"],
      "rules": {
        "id-length": [
          "error",
          { "min": 2, "exceptions": ["x", "y", "z", "$", "_", "v"], "checkGeneric": false }
        ]
      }
    },
    {
      // a spike is throwaway, so product code never depends on one
      "files": ["packages/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@pepys/spike-*", "**/research/**"],
                "message": "product code never imports a spike"
              }
            ]
          }
        ]
      }
    },
    {
      // a core package works for any plug-in, so it imports the named core packages and no other
      "files": [
        "packages/schema/**",
        "packages/contract/**",
        "packages/ingest/**",
        "packages/api/**",
        "packages/cli/**",
        "packages/testing/**",
        "packages/kysely-turso/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@pepys/spike-*", "**/research/**"],
                "message": "product code never imports a spike"
              },
              {
                "group": [
                  "@pepys/*",
                  "!@pepys/kit",
                  "!@pepys/schema",
                  "!@pepys/contract",
                  "!@pepys/ingest",
                  "!@pepys/api",
                  "!@pepys/cli",
                  "!@pepys/testing",
                  "!@pepys/kysely-turso"
                ],
                "message": "a core package imports only the core packages, never a plug-in"
              }
            ]
          }
        ]
      }
    },
    {
      // the kit is published to npm, so it imports no workspace package
      "files": ["packages/kit/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@pepys/spike-*", "**/research/**"],
                "message": "product code never imports a spike"
              },
              {
                "group": ["@pepys/*"],
                "message": "the kit is published, so it imports no workspace package"
              }
            ]
          }
        ]
      }
    }
  ],
  // generated files are written by the schema generators, so a lint fix would be overwritten
  "ignorePatterns": [
    ".claude/**",
    "docs/design/**",
    "packages/*/src/generated/**",
    "packages/*/src/test-utils/*/generated/**",
    "packages/testing/src/ledger/generated/**",
    "e2e/*/src/generated/**"
  ]
}
