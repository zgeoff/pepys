{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@zgeoff/oxlint-config/oxlintrc.json"],
  "env": {
    "node": true,
    "es2024": true
  },
  "rules": {
    // pepys is ES modules throughout, so a module loads through an import
    "typescript/no-require-imports": "error"
  },
  "overrides": [
    {
      // the fact envelope names its version field `v`, and the log doc fixes that name
      "files": ["packages/schema/src/**"],
      "rules": {
        "id-length": [
          "error",
          { "min": 2, "exceptions": ["x", "y", "z", "$", "_", "v"], "checkGeneric": false }
        ]
      }
    },
    {
      // a spike is throwaway, so product code never depends on one
      "files": ["packages/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@pepys/spike-*", "**/research/**"],
                "message": "product code never imports a spike"
              }
            ]
          }
        ]
      }
    }
  ],
  // generated files are written by the schema generators, so a lint fix would be overwritten
  "ignorePatterns": [".claude/**", "docs/design/**", "packages/*/src/generated/**"]
}
