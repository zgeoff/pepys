{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.ts", "stack/**/*.test.ts", "rig.config.ts"],
      "project": ["scripts/**/*.ts", "stack/**/*.ts"]
    },
    "packages/cli/e2e/fixtures/logbook-plugin": {
      "entry": ["src/consumers/*.ts", "src/generated/**/*.ts"],
      "bun": false
    },
    "packages/*": {
      "entry": ["src/**/*.test.ts", "src/generated/**/*.ts!"],
      "bun": false
    },
    "packages/schema": {
      "entry": ["src/**/*.test.ts", "src/**/*.test-d.ts", "src/generated/**/*.ts!"],
      "bun": false
    },
    "packages/source-github": {
      "entry": [
        "src/**/*.test.ts",
        "src/generated/**/*.ts!",
        "src/consumers/*.ts!",
        "src/ingest/serve-ingest.ts!",
        "src/api/serve-api.ts!"
      ],
      "bun": false
    },
    "packages/api": {
      "entry": ["src/**/*.test.ts"],
      "bun": false
    },
    "packages/kit": {
      "entry": ["src/**/*.test.ts"],
      "bun": false
    },
    "packages/cli": {
      "entry": ["src/**/*.test.ts", "e2e/**/*.test.ts", "e2e/fixtures/e2e-deployment.ts"],
      "bun": false
    },
    "packages/contract": {
      "entry": ["src/**/*.test.ts"],
      "bun": false
    },
    "packages/enrichment": {
      "entry": ["src/**/*.test.ts"],
      "bun": false
    },
    "packages/ingest": {
      "entry": ["src/**/*.test.ts", "e2e/**/*.test.ts", "e2e/fixtures/serve-stub-ingest.ts"],
      "bun": false
    },
    "packages/mock-network": {
      "entry": ["src/**/*.test.ts"],
      "bun": false
    },
    "packages/kysely-turso": {
      "entry": ["src/**/*.test.ts"],
      "bun": false
    },
    "packages/testing": {
      "entry": ["src/**/*.test.ts", "src/test-utils/*/consumers/*.ts", "src/ledger/consumers/*.ts"],
      "bun": false
    }
  },
  "ignoreWorkspaces": ["research/**"],
  "ignoreDependencies": [
    "@stylistic/eslint-plugin",
    "@zgeoff/agent-hooks",
    "@zgeoff/diet",
    "@scriptc/runtime-wasm32-wasi"
  ],
  "ignoreIssues": {
    "packages/cli/e2e/**": ["unlisted"]
  }
}
