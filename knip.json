{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.ts"],
      "project": ["scripts/**/*.ts"]
    },
    "packages/*": {
      "entry": ["src/**/*.test.ts", "src/generated/**/*.ts"]
    }
  },
  "ignoreWorkspaces": ["research/**"],
  "ignoreDependencies": ["@stylistic/eslint-plugin", "@zgeoff/skill-gate"]
}
