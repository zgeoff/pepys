{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.ts", "e2e/**/*.test.ts"],
      "project": ["scripts/**/*.ts", "stack/**/*.ts", "e2e/**/*.ts"]
    },
    "packages/*": {
      "entry": ["src/**/*.test.ts", "src/generated/**/*.ts"],
      "bun": false
    },
    "packages/source-github": {
      "entry": [
        "src/**/*.test.ts",
        "src/generated/**/*.ts",
        "src/consumers/*.ts",
        "src/ingest/serve-ingest.ts"
      ],
      "bun": false
    },
    "packages/api": {
      "entry": ["src/**/*.test.ts", "integration/**/*.test.ts", "src/serve.ts"],
      "bun": false
    },
    "packages/contract": {
      "entry": ["src/**/*.test.ts"],
      "bun": false
    },
    "packages/enrichment": {
      "entry": ["src/**/*.test.ts"],
      "bun": false
    },
    "packages/ingest": {
      "entry": ["src/**/*.test.ts"],
      "bun": false
    },
    "packages/kysely-turso": {
      "entry": ["src/**/*.test.ts"],
      "bun": false
    }
  },
  "ignoreWorkspaces": ["research/**"],
  "ignoreDependencies": [
    "@stylistic/eslint-plugin",
    "@zgeoff/skill-gate",
    "@scriptc/runtime-wasm32-wasi",
    "scriptc"
  ]
}
