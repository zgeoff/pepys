{
  "name": "pepys",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "research/*"
    ],
    "catalog": {
      "@commitlint/cli": "21.2.4",
      "@octokit/webhooks": "14.2.0",
      "@orpc/client": "1.16.0",
      "@orpc/server": "1.16.0",
      "@s2-dev/streamstore": "0.30.0",
      "@scriptc/runtime-wasm32-wasi": "0.4.0",
      "@stylistic/eslint-plugin": "5.10.0",
      "@tsconfig/strictest": "2.0.8",
      "@tursodatabase/database": "0.8.3",
      "@types/bun": "1.4.3",
      "@zgeoff/bun-test-extended": "0.2.1",
      "@zgeoff/checks": "0.2.4",
      "@zgeoff/commitlint-config": "0.1.0",
      "@zgeoff/format-codemod": "0.3.3",
      "@zgeoff/oxlint-config": "0.7.1",
      "@zgeoff/skill-gate": "0.2.9",
      "@zgeoff/std": "0.3.0",
      "elysia": "2.0.0-exp.64",
      "exact-mirror": "1.2.6",
      "knip": "6.42.0",
      "kysely": "0.29.7",
      "lefthook": "2.2.2",
      "openapi-types": "12.1.3",
      "oxfmt": "0.73.0",
      "oxlint": "1.88.0",
      "oxlint-tsgolint": "7.0.2004",
      "scriptc": "0.4.0",
      "tiny-invariant": "1.3.3",
      "tombi": "1.8.8",
      "ts-pattern": "5.9.2",
      "tslib": "2.8.1",
      "tsrs": "0.15.0-ts7.1.0-dev.20260929",
      "type-fest": "5.10.0",
      "typebox": "1.4.2",
      "typescript": "7.0.2",
      "zod": "4.6.7"
    }
  },
  "type": "module",
  "scripts": {
    "audit": "bun audit",
    "check": "zgeoff-check",
    "consumers:build": "bun scripts/build-consumers.ts",
    "deadcode": "knip",
    "files:branch": "bun scripts/read-branch-files.ts",
    "format": "oxfmt . && format-codemod --quiet . && tombi format",
    "format:check": "oxfmt --check . && format-codemod --check --quiet . && tombi format --check",
    "lint": "oxlint",
    "lint:files": "oxlint --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint --fix",
    "lint:full": "oxlint --type-aware --type-check --report-unused-disable-directives-severity error",
    "lint:shell": "git ls-files -z '*.sh' ':!.claude/**' | xargs -r0 sh -c 'shellcheck \"$@\" && shfmt -d \"$@\"' sh",
    "lint:toml": "tombi lint",
    "prepare": "command -v git > /dev/null 2>&1 && lefthook install --force || true",
    "schema:check": "bun scripts/generate-schema.ts --check",
    "schema:generate": "bun scripts/generate-schema.ts",
    "slice:check": "bun scripts/check-slice.ts",
    "test": "bun test --randomize --path-ignore-patterns='research/**'",
    "test:related": "bun scripts/run-related-tests.ts",
    "typecheck": "tsrs -p tsconfig.json --noEmit && bun run --if-present --filter './research/*' typecheck",
    "check:commits": "bun scripts/run-commits-check.ts",
    "check:local-paths": "bun scripts/run-local-paths-check.ts",
    "check:test-timeouts": "bun scripts/run-test-timeouts-check.ts",
    "check:workflows": "bun scripts/run-workflows-check.ts",
    "memory-capped": "bash scripts/run-memory-capped.sh \"$(bun scripts/read-memory-budget.ts)\"",
    "check:dependency-gates": "bun scripts/dependency-gates/run-dependency-gates-check.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@octokit/webhooks": "catalog:",
    "@orpc/client": "catalog:",
    "@pepys/api": "workspace:*",
    "@pepys/schema": "workspace:*",
    "@pepys/source-github": "workspace:*",
    "@s2-dev/streamstore": "catalog:",
    "@scriptc/runtime-wasm32-wasi": "catalog:",
    "@stylistic/eslint-plugin": "catalog:",
    "@tsconfig/strictest": "catalog:",
    "@tursodatabase/database": "catalog:",
    "@types/bun": "catalog:",
    "@zgeoff/bun-test-extended": "catalog:",
    "@zgeoff/checks": "catalog:",
    "@zgeoff/commitlint-config": "catalog:",
    "@zgeoff/format-codemod": "catalog:",
    "@zgeoff/oxlint-config": "catalog:",
    "@zgeoff/skill-gate": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "scriptc": "catalog:",
    "tiny-invariant": "catalog:",
    "tombi": "catalog:",
    "tslib": "catalog:",
    "tsrs": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.3",
  "trustedDependencies": [
    "scriptc"
  ]
}
