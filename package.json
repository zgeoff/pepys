{
  "name": "pepys",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "research/*",
      "e2e/logbook-plugin"
    ],
    "catalog": {
      "@commitlint/cli": "21.2.4",
      "@impz/client": "6.12.0",
      "@msw/data": "1.1.8",
      "@mswjs/interceptors": "0.45.11",
      "@octokit/webhooks": "14.2.0",
      "@modelcontextprotocol/server": "2.4.0",
      "@orpc/client": "2.0.0-beta.50",
      "@orpc/contract": "2.0.0-beta.50",
      "@orpc/mcp": "2.0.0-beta.50",
      "@orpc/openapi": "2.0.0-beta.50",
      "@orpc/server": "2.0.0-beta.50",
      "@s2-dev/streamstore": "0.30.0",
      "@scriptc/runtime-wasm32-wasi": "0.4.5",
      "@stylistic/eslint-plugin": "5.10.0",
      "@tsconfig/strictest": "2.0.8",
      "@tursodatabase/database": "0.8.3",
      "@types/bun": "1.4.4",
      "@zgeoff/agent-hooks": "0.2.11",
      "@zgeoff/bun-test-extended": "0.2.3",
      "@zgeoff/checks": "0.2.4",
      "@zgeoff/chex": "0.3.2",
      "@zgeoff/commitlint-config": "0.1.0",
      "@zgeoff/diet": "0.2.2",
      "@zgeoff/format-codemod": "0.3.5",
      "@zgeoff/oxlint-config": "0.10.5",
      "@zgeoff/rig": "0.2.3",
      "@zgeoff/std": "0.4.3",
      "elysia": "2.0.0-rc.1",
      "exact-mirror": "1.2.7",
      "knip": "6.44.1",
      "kysely": "0.29.8",
      "lefthook": "2.2.2",
      "msw": "3.0.3",
      "openapi-types": "12.1.3",
      "oxfmt": "0.75.0",
      "oxlint": "1.90.0",
      "oxlint-tsgolint": "7.0.2005",
      "scriptc": "0.4.5",
      "tiny-invariant": "1.3.3",
      "tombi": "1.10.0",
      "ts-pattern": "5.9.2",
      "tslib": "2.9.1",
      "tsrs": "0.15.0-ts7.1.0-dev.20260929",
      "type-fest": "5.10.0",
      "typebox": "1.4.4",
      "typescript": "7.0.2",
      "zod": "4.6.7"
    }
  },
  "type": "module",
  "scripts": {
    "audit": "bun audit --ignore=GHSA-g3hv-75wg-m249",
    "check": "zgeoff-check",
    "check:outside-install": "bun scripts/outside-install/run-outside-install.ts",
    "consumers:build": "pepys build scripts/stub-deployment.ts --out build/consumers && pepys build e2e/deployment/e2e-deployment.ts --out build/e2e-consumers",
    "deadcode": "bash scripts/run-knip.sh",
    "format": "oxfmt . && format-codemod --quiet . && tombi format",
    "format:check": "oxfmt --check . && format-codemod --check --quiet . && tombi format --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:full": "oxlint --type-aware --type-check --report-unused-disable-directives-severity error",
    "lint:shell": "git ls-files -z '*.sh' ':!.claude/**' | xargs -r0 sh -c 'shellcheck \"$@\" && shfmt -d \"$@\"' sh",
    "lint:toml": "tombi lint",
    "prepare": "command -v git > /dev/null 2>&1 && lefthook install --force || true",
    "schema:check": "bun scripts/generate-schema.ts --check",
    "schema:generate": "bun scripts/generate-schema.ts",
    "test": "rig unit",
    "test:e2e": "bun test --timeout=15000 --path-ignore-patterns='research/**' --preload ./e2e/start-stack.ts ./e2e",
    "test:e2e:rust": "bun scripts/e2e/run-with-stack.ts cargo nextest run --profile e2e --locked --no-tests=fail",
    "test:e2e:prepare": "cargo build --bin pepys --locked && bun run consumers:build",
    "ci:tool-paths": "bun scripts/e2e/write-tool-paths.ts",
    "ci:require-checks": "bun scripts/checks/require-every-check.ts",
    "ci:lint-title": "bun scripts/pr-title/lint-title.ts",
    "ci:agent-sdk-bump": "bun scripts/agent-sdk-bump/write-agent-sdk-bump.ts",
    "ci:check-release-tag": "bun scripts/release/check-release-tag.ts",
    "ci:pack-packages": "bun scripts/release/write-package-tarballs.ts",
    "ci:publish-packages": "bun scripts/release/publish-packages.ts",
    "ci:write-host-asset": "bun scripts/release/write-host-asset.ts",
    "ci:check-host-asset": "bun scripts/release/check-host-asset.ts",
    "ci:publish-host-release": "bun scripts/release/publish-host-release.ts",
    "test:related": "rig related",
    "typecheck": "tsrs -p tsconfig.json --noEmit && bun run --if-present --filter './research/*' typecheck",
    "check:docs": "chex prose length links readmes skill"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@mswjs/interceptors": "catalog:",
    "@octokit/webhooks": "catalog:",
    "@orpc/client": "catalog:",
    "@pepys/api": "workspace:*",
    "@pepys/cli": "workspace:*",
    "@pepys/ingest": "workspace:*",
    "@pepys/kit": "workspace:*",
    "@pepys/schema": "workspace:*",
    "@pepys/source-github": "workspace:*",
    "@pepys/source-telemetry": "workspace:*",
    "@s2-dev/streamstore": "catalog:",
    "@stylistic/eslint-plugin": "catalog:",
    "@tsconfig/strictest": "catalog:",
    "@types/bun": "catalog:",
    "@zgeoff/agent-hooks": "catalog:",
    "@zgeoff/bun-test-extended": "catalog:",
    "@zgeoff/checks": "catalog:",
    "@zgeoff/chex": "catalog:",
    "@zgeoff/commitlint-config": "catalog:",
    "@zgeoff/diet": "catalog:",
    "@zgeoff/format-codemod": "catalog:",
    "@zgeoff/oxlint-config": "catalog:",
    "@zgeoff/rig": "catalog:",
    "@zgeoff/std": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "logbook-plugin": "workspace:*",
    "msw": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tiny-invariant": "catalog:",
    "tombi": "catalog:",
    "tslib": "catalog:",
    "tsrs": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "scriptc"
  ]
}
