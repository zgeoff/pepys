{
  "name": "@pepys/cli",
  "version": "0.4.0",
  "description": "The pepys command line: pepys build checks a deployment or a plug-in, writes the glue of each consumer, and compiles each consumer with scriptc, and pepys start runs a whole deployment",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/pepys.git",
    "directory": "packages/cli"
  },
  "bin": {
    "pepys": "./src/bin.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/test-utils"
  ],
  "type": "module",
  "exports": "./src/index.ts",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@pepys/api": "workspace:*",
    "@pepys/ingest": "workspace:*",
    "@pepys/kit": "workspace:*",
    "@pepys/schema": "workspace:*",
    "@scriptc/runtime-wasm32-wasi": "catalog:",
    "@zgeoff/std": "catalog:",
    "scriptc": "catalog:",
    "tiny-invariant": "catalog:",
    "ts-pattern": "catalog:",
    "xstate": "catalog:"
  },
  "devDependencies": {
    "@octokit/webhooks": "catalog:",
    "@orpc/client": "catalog:",
    "@pepys/source-github": "workspace:*",
    "@pepys/source-telemetry": "workspace:*",
    "@s2-dev/streamstore": "catalog:",
    "@zgeoff/testing": "catalog:",
    "zod": "catalog:"
  }
}
