{
  "name": "@pepys/source-telemetry",
  "version": "0.4.1",
  "description": "The pepys telemetry plug-in: the OTLP log records of coding agents, with their model requests and turn costs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/pepys.git",
    "directory": "packages/source-telemetry"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/test-utils"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./test-utils/*": "./src/test-utils/*.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@pepys/kit": "workspace:*",
    "@zgeoff/std": "catalog:",
    "tiny-invariant": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pepys/cli": "workspace:*",
    "@pepys/ingest": "workspace:*",
    "@pepys/testing": "workspace:*"
  }
}
