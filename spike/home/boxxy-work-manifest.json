  "schema": "CREATE TABLE \"boxxy_item\" (\n  \"id\" TEXT NOT NULL,\n  \"kind\" TEXT NOT NULL,\n  \"repo\" TEXT NOT NULL,\n  \"title\" TEXT NOT NULL,\n  \"design_mode\" TEXT,\n  \"filed_at\" TEXT NOT NULL,\n  \"closed_at\" TEXT,\n  \"close_reason\" TEXT,\n  \"updated_at\" TEXT NOT NULL,\n  PRIMARY KEY (\"id\")\n);\n\nCREATE TABLE \"boxxy_attempt\" (\n  \"id\" TEXT NOT NULL,\n  \"item_id\" TEXT NOT NULL,\n  \"phase\" TEXT NOT NULL,\n  \"number\" INTEGER NOT NULL,\n  \"round\" INTEGER NOT NULL,\n  \"mode\" TEXT NOT NULL,\n  \"pool\" TEXT NOT NULL,\n  \"recipe_hash\" TEXT NOT NULL,\n  \"rules_version\" TEXT NOT NULL,\n  \"atc_session\" TEXT,\n  \"state\" TEXT NOT NULL,\n  \"outcome\" TEXT,\n  \"failure\" TEXT,\n  \"claimed_at\" TEXT NOT NULL,\n  \"started_at\" TEXT,\n  \"closed_out_at\" TEXT,\n  \"ended_at\" TEXT,\n  \"sleeps\" TEXT NOT NULL,\n  \"updated_at\" TEXT NOT NULL,\n  PRIMARY KEY (\"id\")\n);\n\nCREATE INDEX \"boxxy_attempt_item_id_idx\" ON \"boxxy_attempt\" (\"item_id\");\n\nCREATE TABLE \"boxxy_attempt_session\" (\n  \"attempt_id\" TEXT NOT NULL,\n  \"session_id\" TEXT NOT NULL,\n  \"key\" TEXT NOT NULL,\n  \"product\" TEXT,\n  \"bound_at\" TEXT NOT NULL,\n  PRIMARY KEY (\"attempt_id\", \"session_id\")\n);\n\nCREATE INDEX \"boxxy_attempt_session_session_id_idx\" ON \"boxxy_attempt_session\" (\"session_id\");\n\nCREATE VIEW \"entity\" AS\nSELECT \"id\" AS \"id\", 'boxxy:item' AS \"kind\", \"title\" AS \"title\", NULL AS \"url\", NULL AS \"actor\", \"updated_at\" AS \"updated_at\" FROM \"boxxy_item\"\nUNION ALL\nSELECT \"id\" AS \"id\", 'boxxy:attempt' AS \"kind\", \"phase\" AS \"title\", NULL AS \"url\", NULL AS \"actor\", \"updated_at\" AS \"updated_at\" FROM \"boxxy_attempt\";\n"
}